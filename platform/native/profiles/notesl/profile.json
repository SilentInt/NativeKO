{
  "id": "notesl",
  "model": "Onyx NoteS (超星 NoteSL)",
  "match": {
    "product": "NoteS",
    "brand": "Onyx"
  },
  "display": {
    "fb": "/dev/graphics/fb0",
    "blank": "/sys/class/graphics/fb0/blank",
    "pan": "/sys/class/graphics/fb0/pan",
    "pan_value": "0,0",
    "backend": "rk_ebc",
    "portrait": true,
    "touch_rotation": 0,
    "dpi": 160,
    "can_hw_invert": false,
    "can_hw_dither": false,
    "ebc_device": "/dev/ebc",
    "ebc_width": 1200,
    "ebc_height": 825,
    "ebc_bpp": 32,
    "ebc_stride": 4800,
    "ebc_offset": 0,
    "ebc_rotate": 0,
    "ebc_enabled": true,
    "ebc_send_initial": true,
    "ebc_send_buffer_each": true,
    "ebc_epd_mode": 1,
    "ebc_cmd_send_buffer": 28673,
    "ebc_cmd_send_update": 28684,
    "ebc_rect_order": "yxwh",
    "ebc_waveform_full": 2,
    "ebc_update_mode_full": 1,
    "ebc_waveform_partial": 2,
    "ebc_update_mode_partial": 0,
    "ebc_waveform_fast": 1,
    "ebc_update_mode_fast": 0,
    "ebc_flags": 135168,
    "ebc_unknown_1c": 4096,
    "needs_refresh_after_resume": true
  },
  "input": {
    "devices": [
      "/dev/input/event0",
      "/dev/input/event1"
    ],
    "keys": {
      "116": "Power",
      "158": "Back"
    },
    "quirks": [
      "power_down_only",
      "touch_swap_xy",
      "touch_invert_x"
    ],
    "touch_max_x": 1200,
    "touch_max_y": 825
  },
  "power": {
    "battery_capacity": "/sys/class/power_supply/battery/capacity",
    "battery_status": "/sys/class/power_supply/battery/status",
    "frontlight": "",
    "fl_min": 0,
    "fl_max": 255,
    "model": "android_wakeup_count",
    "suspend_state": "mem",
    "suspend_fallback": "standby",
    "suspend_wait_timeout": 2,
    "wake_lock_name": "nativeko",
    "wake_unlock": [
      "PowerManagerService.Display",
      "PowerManagerService.WakeLocks",
      "KeyEvents"
    ],
    "rtc_alarm": "/sys/class/rtc/rtc0/wakealarm",
    "suspend_unbind": [
      "dwmmc_rockchip:ff0d0000.rksdmmc"
    ]
  },
  "network": {
    "manage": true,
    "start_on_boot": false,
    "iface": "wlan0",
    "backend": "wpa_supplicant_android",
    "ctrl_dir": "/dev/socket",
    "service": "wpa_supplicant",
    "dhcp_service": "dhcpcd_wlan0",
    "dhcp_cmd": "/system/bin/dhcpcd",
    "dhcp_flags": "-aABDKL",
    "driver_module": "bcmdhd",
    "android_props": true,
    "service_prop": "init.svc.wpa_supplicant",
    "ctrl_interface": "/dev/socket/wpa_wlan0",
    "wpa_global": true,
    "wpa_ifname": "wlan0"
  },
  "host": {
    "backend": "android_init",
    "stop": [
      "zygote",
      "surfaceflinger",
      "media",
      "drm",
      "installd",
      "keystore"
    ],
    "start": [
      "surfaceflinger",
      "media",
      "drm",
      "installd",
      "keystore",
      "zygote"
    ],
    "governor_native": "interactive",
    "governor_fallback": "conservative"
  },
  "paths": {
    "data_dir": "/sdcard/koreader",
    "home_dir": "/sdcard/Books"
  },
  "tools": {
    "ip": "/system/bin/ip",
    "ping": "/system/bin/ping",
    "setsid": "/system/bin/setsid",
    "getprop": "getprop",
    "busybox": "/system/bin/toybox"
  }
}
